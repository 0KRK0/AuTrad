# Copy to .env (never commit .env). In production load these from AWS Secrets Manager / Vault.
POSTGRES_PASSWORD=change-me
API_TOKENS=replace-with-long-random-admin-token:admin,replace-with-viewer-token:viewer
CORS_ORIGINS=http://localhost
AUTRAD_CONTACT_EMAIL=you@example.com
# Live trading stays disabled. Broker keys are only read by the (not yet enabled) live adapter.
BROKER_API_KEY=
BROKER_API_SECRET=
